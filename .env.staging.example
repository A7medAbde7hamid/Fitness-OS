# Staging Environment Configuration
# Copy to .env.staging and fill in values
#
# Staging Supabase Project:
#   Name: fitness-os
#   Project ID: hroghkokafsyxdzprvem
#   Region: EU Central (Frankfurt)
#   URL: https://hroghkokafsyxdzprvem.supabase.co

# Gemini API Key (server-side only, never exposed to client)
GEMINI_API_KEY=

# App URL (staging deployment URL)
APP_URL=http://localhost:3000

# Supabase (staging project)
VITE_SUPABASE_URL=https://hroghkokafsyxdzprvem.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase
SUPABASE_URL=https://hroghkokafsyxdzprvem.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp (mock mode for staging sandbox testing)
WHATSAPP_PROVIDER=mock
WHATSAPP_VERIFY_TOKEN=staging-verify-token

# Rate limiting (enabled in staging)
RATE_LIMIT_ENABLED=true

# Auth callback URLs
AUTH_CALLBACK_URL=http://localhost:3000

# Log level
LOG_LEVEL=info
